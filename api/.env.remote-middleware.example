# ==================================================================
# Local Dify (source run) -> remote middleware on a cloud server
#
# Copy this file to api/.env and fill in real values.
# Based on api/.env.example; only the keys that differ from a
# default local middleware setup are listed here. All other keys
# keep their .env.example defaults.
#
# NOTE: the sandbox (dify-sandbox) runs on the same cloud server,
# exposed on port 8194. PostgreSQL / Redis / Milvus are existing
# containers on that server, reused across projects.
# ==================================================================

# Session signing key — generate your own: `openssl rand -base64 42`
SECRET_KEY=<base64-secret>

# ------------------------------------------------------------------
# Database (PostgreSQL 15) — reuse existing instance
# Two databases required: main db below + a plugin db (see DB_PLUGIN_DATABASE
# in docker/.env.example; create e.g. `dify_plugin` on the same instance)
# ------------------------------------------------------------------
DB_TYPE=postgresql
DB_HOST=<server-ip>
DB_PORT=5432
DB_USERNAME=<pg-user>
DB_PASSWORD=<pg-password>
DB_DATABASE=dify

# ------------------------------------------------------------------
# Redis — reuse existing instance
# Dify uses db0 for cache and db1 as Celery broker; keep REDIS_DB=0
# unless another app on the same Redis already occupies db0.
# ------------------------------------------------------------------
REDIS_HOST=<server-ip>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>
REDIS_DB=0
CELERY_BROKER_URL=redis://:<redis-password>@<server-ip>:6379/1
CELERY_BACKEND=redis

# ------------------------------------------------------------------
# Vector store (Milvus standalone) — reuse existing instance
# ------------------------------------------------------------------
VECTOR_STORE=milvus
MILVUS_URI=http://<server-ip>:19530
MILVUS_DATABASE=default

# ------------------------------------------------------------------
# DifySandbox — deployed on the cloud server, port 8194
# API key must match the SANDBOX_API_KEY given to the sandbox container
# ------------------------------------------------------------------
CODE_EXECUTION_ENDPOINT=http://<server-ip>:8194
CODE_EXECUTION_API_KEY=<sandbox-api-key>

# ------------------------------------------------------------------
# URLs — local source run: API on 5001, web on 3000
# ------------------------------------------------------------------
CONSOLE_API_URL=http://localhost:5001
CONSOLE_WEB_URL=http://localhost:3000
SERVICE_API_URL=http://localhost:5001
APP_WEB_URL=http://localhost:3000
FILES_URL=http://localhost:5001
TRIGGER_URL=http://localhost:5001
INTERNAL_FILES_URL=http://host.docker.internal:5001

# ==================================================================
# Windows-specific notes (local source run on Windows)
# ------------------------------------------------------------------
# 1. gunicorn is not available on Windows. Run the API with:
#      flask run --host 127.0.0.1 --port 5001
#    and the worker with:
#      celery -A app.celery worker --pool=solo --concurrency=1
#
# 2. python-magic hangs forever on Windows when it cannot find a
#    libmagic DLL. Install python-magic-bin instead:
#      uv pip install python-magic-bin==0.4.14
#
# 3. Only install the vdb group you actually use, e.g.:
#      uv sync --frozen --no-default-groups \
#        --group kms --group storage --group tools --group trace-all \
#        --group vdb-milvus
#
# 4. First run: `flask db upgrade` creates the full schema
#    (144 tables) in the empty `dify` database.
#
# 5. If a local proxy TUN (Clash/mihomo "Meta") intercepts traffic to
#    the server, add a direct route for the server IP, e.g.:
#      route add <server-ip> mask 255.255.255.255 <lan-gateway> metric 1
# ==================================================================
